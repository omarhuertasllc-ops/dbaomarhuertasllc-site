{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appleapps-site",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{"pattern":"appleapps.dbaomarhuertasllc.com","custom_domain":true}],
